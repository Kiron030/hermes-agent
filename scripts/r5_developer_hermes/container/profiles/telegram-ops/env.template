# telegram-ops host-local secrets. Copied to .env inside the persistent
# HERMES_HOME volume at seed time. Never commit the copied .env.
#
# LIVE token cutover is TELEGRAM_EXISTING_PATH_0C_ACTIVATE only.
# 0B PREP must leave these values empty so Railway keeps the live poller.

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=

# Must remain unset or false. Empty/missing allowlist fails closed.
# TELEGRAM_ALLOW_ALL_USERS=
# GATEWAY_ALLOW_ALL_USERS=

# Long polling only. Must remain unset.
# TELEGRAM_WEBHOOK_URL=

# Groups are disabled for the initial Telegram path.
# TELEGRAM_GROUP_ALLOWED_USERS=
# TELEGRAM_GROUP_ALLOWED_CHATS=
# TELEGRAM_ALLOWED_CHATS=
